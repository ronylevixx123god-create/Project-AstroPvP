<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.conaxgames</groupId>
    <artifactId>ProjectAstro</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>

    <modules>
        <module>Utils</module>
        <module>Ark</module>
        <module>AuctionHouse</module>
        <module>SpaceChests</module>
        <module>Bosses</module>
        <module>Factions</module>
        <module>Slotbot</module>
        <module>Core</module>
        <module>Sets</module>
        <module>Enchantments</module>
        <module>Attributes</module>
        <module>CustomItems</module>
        <module>Explosive</module>
        <module>KoTHs</module>
        <module>ItemSkins</module>
        <module>Kits</module>
        <module>Pets</module>
        <module>Dungeon</module>
        <module>Lootboxes</module>
        <module>Disguises</module>
        <module>Duels</module>
        <module>Contest</module>
        <module>Conquest</module>
        <module>CompilexPermissions</module>
        <module>Masks</module>
        <module>EnchantmentsAPI</module>
        <module>CustomBlocks</module>
        <module>AstroEndGrinding</module>
        <module>Tournaments</module>
        <module>AstroSpawnersMobcoins</module>
        <module>AstroScoreboard</module>
        <module>WeaponRunes</module>
        <module>ItemFlip</module>
        <module>AstroRevive</module>
        <module>HotFix</module>
        <module>FactionBanners</module>
        <module>AstroCollect</module>
        <module>CosmicShop</module>
        <module>CosmicCrate</module>
        <module>SandBots</module>
    </modules>

    <build>
        <defaultGoal>clean install</defaultGoal>
        <resources>
            <resource>
                <directory>src/astroCore/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <version>3.6.1</version>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <shadedArtifactAttached>false</shadedArtifactAttached>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
